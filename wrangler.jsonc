{
  // etoolbox: static site (assets) + a small Worker for /api/* (website screenshots)
  "name": "toolz",
  "main": "_worker/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/logo/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "browser": { "binding": "BROWSER" },
  "kv_namespaces": [
    { "binding": "LOGOS", "id": "5c09f08646244ede849dff8209506cd1" },
    { "binding": "PRO", "id": "adbb0b2ca9d4413b9ad2813d44c4b79b" }
  ]
}
